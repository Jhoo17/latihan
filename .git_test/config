[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[branch "main"]
	vscode-merge-base = origin/main
[remote "origin"]
	url = https://github.com/Jhoo17/latihan.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "clean-branch"]
	remote = origin
	merge = refs/heads/clean-branch
